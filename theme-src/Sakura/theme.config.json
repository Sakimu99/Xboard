{
  "name": "Sakura",
  "description": "日系二次元风格用户前台，粉白配色（React + shadcn/ui）",
  "version": "1.0.0",
  "images": "",
  "configs": [
    {
      "label": "动态特效",
      "placeholder": "樱花飘落、点击星星、鼠标光晕等",
      "field_name": "effects",
      "field_type": "select",
      "select_options": {
        "full": "全部开启",
        "lite": "仅光效（不飘樱花）",
        "off": "关闭"
      },
      "default_value": "full"
    },
    {
      "label": "立绘背景图",
      "placeholder": "建议白底横图（角色在右侧），支持随机图 API",
      "field_name": "background_url",
      "field_type": "input",
      "default_value": "https://t.alcy.cc/bd"
    },
    {
      "label": "仪表盘横幅图",
      "placeholder": "横图，支持随机图 API，留空则不显示图片",
      "field_name": "banner_url",
      "field_type": "input",
      "default_value": "https://t.alcy.cc/moe"
    },
    {
      "label": "看板娘贴图",
      "placeholder": "白底 Q 版贴图，用于侧栏、空状态等，留空则不显示",
      "field_name": "sticker_url",
      "field_type": "input",
      "default_value": "https://t.alcy.cc/xhl"
    },
    {
      "label": "登录页标语",
      "placeholder": "留空使用站点描述",
      "field_name": "hero_title",
      "field_type": "input"
    },
    {
      "label": "默认语言",
      "placeholder": "请选择默认语言",
      "field_name": "default_language",
      "field_type": "select",
      "select_options": {
        "zh-CN": "简体中文",
        "zh-TW": "繁體中文",
        "en-US": "English"
      },
      "default_value": "zh-CN"
    },
    {
      "label": "自定义页脚 HTML",
      "placeholder": "可加入客服 JS 等代码",
      "field_name": "custom_html",
      "field_type": "textarea"
    }
  ]
}
